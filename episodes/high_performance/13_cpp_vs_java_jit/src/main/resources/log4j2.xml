<Configuration status="WARN">
    <Appenders>
        <Console name="StandardConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n" />
        </Console>

        <Console name="TableConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%msg%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="com.hotpath.episode13.runner.TableLogger" level="INFO" additivity="false">
            <AppenderRef ref="TableConsole" />
        </Logger>

        <Root level="INFO">
            <AppenderRef ref="StandardConsole" />
        </Root>
    </Loggers>
</Configuration>
