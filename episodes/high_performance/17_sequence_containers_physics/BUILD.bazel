load("@rules_cc//cc:defs.bzl", "cc_binary")
load("@rules_java//java:defs.bzl", "java_binary", "java_library")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "benchmark",
    srcs = ["benchmark.cc"],
    deps = [
        "//common/sequence_containers",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    deps = [
        "//common/sequence_containers",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_binary(
    name = "live_alloc_audit",
    srcs = ["live_alloc_audit.cc"],
    deps = [
        "//common/sequence_containers",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

java_library(
    name = "java_sequence_lib",
    srcs = glob(["java/**/*.java"]),
)

java_binary(
    name = "java_challenge",
    jvm_flags = [
        "-Xms2g",
        "-Xmx2g",
        "-XX:+AlwaysPreTouch",
        "-XX:+UseG1GC",
    ],
    main_class = "com.hotpath.episode17.JavaSequenceChallenge",
    runtime_deps = [
        ":java_sequence_lib",
    ],
)
