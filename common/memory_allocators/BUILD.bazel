load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "memory_allocators",
    hdrs = ["memory_allocators.h"],
)

cc_test(
    name = "memory_allocators_test",
    srcs = ["memory_allocators_test.cc"],
    deps = [
        ":memory_allocators",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "memory_allocators_benchmark",
    srcs = ["memory_allocators_benchmark.cc"],
    deps = [
        ":memory_allocators",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    deps = [
        ":memory_allocators",
    ],
)

cc_binary(
    name = "live_heap_aging_repro",
    srcs = ["live_heap_aging_repro.cc"],
    deps = [
        ":memory_allocators",
    ],
)
