load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "order_dispatcher",
    hdrs = ["order_dispatcher.h"],
    copts = ["-std=c++20"],
)

cc_library(
    name = "instrument_feed",
    hdrs = ["instrument_feed.h"],
    copts = ["-std=c++20"],
)

cc_test(
    name = "order_dispatcher_test",
    srcs = ["order_dispatcher_test.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":instrument_feed",
        ":order_dispatcher",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "dispatch_benchmark",
    srcs = ["dispatch_benchmark.cc"],
    copts = ["-std=c++20"],
    deps = [
        ":instrument_feed",
        ":order_dispatcher",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    copts = ["-std=c++20"],
    deps = [
        "@google_benchmark//:benchmark_main",
    ],
)

cc_test(
    name = "challenge_test",
    srcs = ["challenge.cc"],
    args = ["--benchmark_min_time=0.001s"],
    copts = ["-std=c++20"],
    tags = ["benchmark"],
    deps = [
        "@google_benchmark//:benchmark_main",
    ],
)
