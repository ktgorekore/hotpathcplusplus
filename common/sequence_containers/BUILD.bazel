load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "sequence_containers",
    hdrs = ["sequence_containers.h"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/strings",
        "@boost.circular_buffer//:boost.circular_buffer",
        "@boost.intrusive//:boost.intrusive",
        "@folly//folly:fbvector",
    ],
)

cc_test(
    name = "sequence_containers_test",
    srcs = ["sequence_containers_test.cc"],
    deps = [
        ":sequence_containers",
        "@googletest//:gtest_main",
    ],
)

alias(
    name = "sequence_containers_benchmark",
    actual = "//episodes/high_performance/17_sequence_containers_physics:benchmark",
)

alias(
    name = "challenge",
    actual = "//episodes/high_performance/17_sequence_containers_physics:challenge",
)

alias(
    name = "live_alloc_audit",
    actual = "//episodes/high_performance/17_sequence_containers_physics:live_alloc_audit",
)
