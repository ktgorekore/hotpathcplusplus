load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cpp_vs_java_jit",
    srcs = ["cpp_vs_java_jit_oop_tu.cc"],
    hdrs = ["cpp_vs_java_jit.h"],
    copts = [
        "-O3",
        "-march=native",
    ],
)

cc_test(
    name = "cpp_vs_java_jit_test",
    srcs = ["cpp_vs_java_jit_test.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":cpp_vs_java_jit",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "cpp_vs_java_jit_benchmark",
    srcs = ["cpp_vs_java_jit_benchmark.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":cpp_vs_java_jit",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "cpp_vs_java_jit_benchmark_lto",
    srcs = [
        "cpp_vs_java_jit.h",
        "cpp_vs_java_jit_benchmark.cc",
        "cpp_vs_java_jit_oop_tu.cc",
    ],
    copts = [
        "-O3",
        "-march=native",
        "-flto",
    ],
    linkopts = [
        "-flto",
    ],
    deps = [
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":cpp_vs_java_jit",
    ],
)
