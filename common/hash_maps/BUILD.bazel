load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hash_maps",
    hdrs = ["hash_maps_across_languages.h"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
    ],
)

cc_test(
    name = "hash_maps_test",
    srcs = ["hash_maps_across_languages_test.cc"],
    deps = [
        ":hash_maps",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "hash_maps_benchmark",
    srcs = ["hash_maps_benchmark.cc"],
    deps = [
        ":hash_maps",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    deps = [
        ":hash_maps",
        "@abseil-cpp//absl/container:flat_hash_map",
    ],
)

cc_binary(
    name = "live_hashdos_repro",
    srcs = ["live_hashdos_repro.cc"],
    deps = [
        ":hash_maps",
        "@abseil-cpp//absl/container:flat_hash_map",
    ],
)
