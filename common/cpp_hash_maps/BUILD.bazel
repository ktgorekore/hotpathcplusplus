load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "cpp_hash_maps",
    hdrs = ["cpp_hash_maps.h"],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/container:inlined_vector",
        "@abseil-cpp//absl/container:node_hash_map",
        "@boost.unordered//:boost.unordered",
        "@folly//folly/container:f14_hash",
    ],
)

cc_test(
    name = "cpp_hash_maps_test",
    srcs = ["cpp_hash_maps_test.cc"],
    deps = [
        ":cpp_hash_maps",
        "@googletest//:gtest_main",
    ],
)

alias(
    name = "cpp_hash_maps_benchmark",
    actual = "//episodes/high_performance/16_cpp_hash_maps_deep_dive:benchmark",
)

alias(
    name = "challenge",
    actual = "//episodes/high_performance/16_cpp_hash_maps_deep_dive:challenge",
)

alias(
    name = "live_alloc_audit",
    actual = "//episodes/high_performance/16_cpp_hash_maps_deep_dive:live_alloc_audit",
)

alias(
