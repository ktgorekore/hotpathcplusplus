load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "memory_safety",
    hdrs = [
        "memory_safety.h",
        "order_book_types.h",
    ],
    copts = [
        "-O3",
        "-march=native",
    ],
)

cc_test(
    name = "memory_safety_test",
    srcs = ["memory_safety_test.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":memory_safety",
        "@googletest//:gtest_main",
    ],
)

cc_binary(
    name = "memory_safety_benchmark",
    srcs = ["memory_safety_benchmark.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":memory_safety",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "memory_safety_benchmark_hardened",
    srcs = ["memory_safety_benchmark.cc"],
    copts = [
        "-O3",
        "-march=native",
        "-D_GLIBCXX_ASSERTIONS",
    ],
    deps = [
        ":memory_safety",
        "@google_benchmark//:benchmark_main",
    ],
)

cc_binary(
    name = "challenge",
    srcs = ["challenge.cc"],
    copts = [
        "-O3",
        "-march=native",
    ],
    deps = [
        ":memory_safety",
    ],
)

cc_binary(
    name = "live_uaf_repro",
    srcs = ["live_uaf_repro.cc"],
    copts = [
        "-O2",
        "-g",
        "-Wall",
        "-Wextra",
    ],
    deps = [
        ":memory_safety",
    ],
)
